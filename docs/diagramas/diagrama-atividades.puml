@startuml diagrama-atividades
skinparam shadowing false
skinparam dpi 140
skinparam backgroundColor white

title Diagrama de atividades — leitor.py

start
:Criar o leitor EasyOCR\ncom os idiomas pt e en;
:Zerar velocidade e distância\ne criar as três séries vazias;
:Abrir test_telemetria.mp4;

while (cap.read() devolveu um quadro?) is (sim)
  :Converter o quadro de BGR para HSV;
  :Mascarar o verde no recorte do acelerador\nlinhas 585:690, colunas 1053:1095\nHSV [35, 40, 40] a [85, 255, 255];
  :Anexar countNonZero à série do acelerador;
  :Mascarar o rosa no recorte do freio\nlinhas 575:677, colunas 1053:1095\nHSV [140, 100, 100] a [168, 255, 255];
  :Anexar countNonZero à série do freio;
  :Recortar a velocidade\nlinhas 610:640, colunas 1128:1212\ne converter de BGR para RGB;
  :Reconhecer o texto com EasyOCR;
  if (há resultado com confiança > 0,5\ne texto só de dígitos?) then (sim)
    :velocidade = inteiro do último\nresultado aceito nesse quadro;
  else (não)
    :A velocidade armazenada permanece\n(0 até a primeira leitura aceita);
  endif
  :distância = distância + (velocidade / 3,6) × 0,033;
  :Anexar a distância à série;
endwhile (não)

:acelerador = (acelerador / máximo) × 100;
note right
  Vídeo sem quadros ou máximo igual a 0
  interrompe o script nessa normalização.
  O percentual é relativo ao pico da
  própria gravação, não a uma escala
  calibrada do pedal.
end note
:Traçar o acelerador em verde\ncontra a distância;
:freio = (freio / máximo) × 100;
:Traçar o freio em vermelho\ncontra a distância;
:Aplicar fundo escuro, preenchimento,\ngrade e os rótulos do gráfico;
:Exibir o gráfico e aguardar\no fechamento da janela;
:Liberar o arquivo de vídeo;
stop
@enduml
