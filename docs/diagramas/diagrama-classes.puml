@startuml diagrama-classes
!pragma layout smetana
skinparam shadowing false
skinparam dpi 140
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam wrapWidth 220
hide circle
left to right direction

title Diagrama de classes lógico — leitor de telemetria (versão revisada)

note as Escopo
  leitor.py é um script procedural; só DetectorVoltas é classe no código.
  Os demais retângulos reúnem dados e funções que o script exerce.
  As ligações são de uso.
end note

class LeitorTelemetria <<script>> {
  executar()
  avisarRecorteVazio(): RNF07
}

class Preset {
  nome = "lmu_gfn_720p"
  acelerador, freio, velocidade
  cronometro, numeroVolta
  areaAcelerador, areaFreio
}

class CapturaDeVideo {
  caminho
  fps: lido do arquivo (30 se ausente)
  lerQuadro(): imagem BGR
  liberar()
}

class DetectorDeBarra {
  rotulo: acelerador ou freio
  faixaHSV
  contarPixels(quadroHSV): int
}

class LeitorDeVelocidade {
  idiomas = pt, en
  confiancaMinima = 0,5
  velMax = 400 km/h
  saltoMax = 15 km/h por quadro
  ler(quadroBGR): int ou nenhum
  statusDoQuadro: aceito ou motivo
}

class IntegradorDeDistancia {
  velocidadeKmh = 0
  distanciaM = 0
  passo = 1/fps
  avancar(): float
}

class SerieTemporal {
  pixelsAcelerador, pixelsFreio
  velocidade, distancia, statusOCR
  percentual(metodo = p99 | max | fixa)
}

class DetectorVoltas {
  passo = 5 quadros
  numeros: contagem do nº da volta
  amostra(quadro, tempo): evento
  fechar(limite): estatísticas
}

class LeitorDeCronometro {
  idiomas = en
  lerTempo(recorte): segundos
  lerNumero(recorte): int
  refinarLimite(buffer)
}

class GravadorDeVoltas {
  invalidaApos = 8 s
  registrar(início, fim, tempoHUD)
  gravarVolta(): volta_seqNN_hudMM.csv
  gravarResumo(): voltas.csv
}

class CatalogoDePistas {
  arquivo = pistas.json
  toleranciaPct = 5
  resolver(pista, comprimento): metros
  distanciaNaPista(distância): [0, L], erro %
  avisarDesvio(erro)
}

class GraficoDeTelemetria {
  eixoX = [0, comprimento] por volta
  exibir() ou gravarPNG()
}

LeitorTelemetria --> Preset : carrega
LeitorTelemetria --> CatalogoDePistas : resolve a pista
LeitorTelemetria --> CapturaDeVideo : lê
LeitorTelemetria --> DetectorDeBarra : aplica (2x)
LeitorTelemetria --> LeitorDeVelocidade : consulta
LeitorTelemetria --> IntegradorDeDistancia : atualiza
LeitorTelemetria --> SerieTemporal : acumula
LeitorTelemetria --> DetectorVoltas : alimenta a cada 5 quadros
DetectorVoltas --> LeitorDeCronometro : usa
LeitorTelemetria --> GravadorDeVoltas : fecha volta
GravadorDeVoltas --> SerieTemporal : normaliza o trecho da volta
GravadorDeVoltas --> CatalogoDePistas : ajusta a distância
GravadorDeVoltas --> GraficoDeTelemetria : PNG da volta (opcional)
LeitorTelemetria --> GraficoDeTelemetria : desenha
@enduml
