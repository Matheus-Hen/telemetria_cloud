@startuml diagrama-casos-de-uso
top to bottom direction
skinparam shadowing false
skinparam dpi 140
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam nodesep 16
skinparam ranksep 18

title Diagrama de casos de uso — leitor de telemetria

actor "Piloto" as piloto
actor "Arquivo de vídeo\n(test_telemetria.mp4)" as video

rectangle "Leitor de telemetria" {
  usecase "Processar o vídeo\nde telemetria" as UC1
  together {
    usecase "Segmentar o acelerador\n(máscara HSV verde)" as UC2
    usecase "Segmentar o freio\n(máscara HSV rosa)" as UC3
    usecase "Reconhecer a velocidade\n(dígitos, confiança configurável)" as UC4
  }
  together {
    usecase "Integrar a distância\n(passo 1/fps do vídeo)" as UC5
    usecase "Normalizar cada barra\npelo máximo da gravação" as UC6
    usecase "Exibir o gráfico\npercentual por distância" as UC7
  }
  usecase "Gravar o gráfico em PNG" as UC8
  usecase "Exportar a série em CSV" as UC9
}

piloto --> UC1
video --> UC1

' A seta parte do caso de uso base e chega no caso incluído.
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<include>>
UC1 ..> UC7 : <<include>>
UC8 ..> UC7 : <<extend>>
UC9 ..> UC1 : <<extend>>
@enduml
